# ============================================
# TULIAN Project - Root .gitignore
# ============================================

# ============================================
# Python
# ============================================
# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest_cache/

# Translations
*.mo
*.pot

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ============================================
# Node.js (for frontend)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ============================================
# IDE and Editors
# ============================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ============================================
# OS specific
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# Project-specific - Large/Generated Files
# ============================================
# Logs
*.log
geocoding_log.txt
logs/

# Generated JSON data
simulated_data*.json
simulation_coverage_report.json
backend/simulated_data*.json
backend/latest_structure.json

# Temporary/cache files
*.local
*.tmp
*.temp
.cache/

# ============================================
# Build outputs
# ============================================
dist/
dist-ssr/
frontend/dist/
backend/dist/

# ============================================
# Environment and secrets
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
config/secrets.yaml

# ============================================
# Data files (optional - uncomment if needed)
# ============================================
# Uncomment if you don't want to track large data files
# DATA/
# context/*.xlsx
# ODK/*.xlsx
